---
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = 'SITAVANI | सीतावाणी — Source-attributed editorial coverage',
  description = 'SITAVANI publishes source-attributed editorial coverage of heritage, science, technology, infrastructure, defense, governance, and Bhartiya knowledge traditions.',
  canonicalUrl = 'https://sitavani.com/'
} = Astro.props;

const jsonLdSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: 'SITAVANI | सीतावाणी',
  url: 'https://sitavani.com',
  description,
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://sitavani.com/?search={search_term_string}',
    'query-input': 'required name=search_term_string'
  }
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SITAVANI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Noto+Serif+Devanagari:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={jsonLdSchema} />
  </head>
  <body class="bg-[#07080B] text-slate-100 antialiased selection:bg-amber-500/30 selection:text-amber-200 min-h-screen">
    <slot />
  </body>
</html>
