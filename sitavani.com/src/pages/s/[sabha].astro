---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SocialFeed } from '../../components/SocialFeed';
import { socialRepository } from '../../data/socialRepository';
import type { DisplayLanguage } from '../../types';

export const prerender = false;

const { sabha } = Astro.params;
if (!sabha) {
  return Astro.redirect('/');
}

const sabhas = await socialRepository.getSabhas();
const currentSabha = sabhas.find(s => s.slug.toLowerCase() === sabha.toLowerCase());

if (!currentSabha) {
  Astro.response.status = 404;
}

const url = new URL(Astro.request.url);
const sortParam = (url.searchParams.get('sort') || 'hot') as 'hot' | 'new' | 'top';
const searchParam = url.searchParams.get('q') || '';
const requestedLanguage = url.searchParams.get('lang');
const language: DisplayLanguage = requestedLanguage === 'hi' || requestedLanguage === 'en' ? requestedLanguage : 'dual';

const { posts } = currentSabha ? await socialRepository.listPosts({
  sabha: currentSabha.slug,
  sort: sortParam,
  search: searchParam,
  limit: 30
}) : { posts: [] };
---

<Layout
  title={currentSabha ? `${currentSabha.name_sa} (${currentSabha.name_en}) | SITAVANI मण्डल` : 'मण्डलम् न लब्धम् | SITAVANI'}
  description={currentSabha ? currentSabha.description_en : 'Sanatana Community Mandalam'}
>
  <div class="min-h-screen flex flex-col bg-[#07090E] text-slate-100 font-sans">
    <Header currentPath={`/s/${sabha}`} language={language} />

    {currentSabha && (
      <!-- Sabha Banner -->
      <div class="border-b border-amber-900/30 bg-gradient-to-r from-amber-950/40 via-[#0A0D15] to-amber-950/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-3xl shadow-inner shadow-amber-500/20">
                {currentSabha.icon}
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h1 class="text-xl sm:text-2xl font-bold font-serif text-slate-100">
                    {currentSabha.name_sa}
                  </h1>
                  <span class="text-xs font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40">
                    s/{currentSabha.slug}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-300 mt-0.5 font-medium">
                  {currentSabha.name_en} • <span class="font-hindi-serif">{currentSabha.name_hi}</span>
                </p>
                <p class="text-xs text-slate-400 mt-1 max-w-2xl">
                  {currentSabha.description_en}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <a
                href="/news"
                class="px-3.5 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-semibold flex items-center gap-1.5 transition-colors"
              >
                <span>📰</span>
                <span>वार्ता विभाग (News Wire)</span>
              </a>
              <a
                href="/"
                class="px-3.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 text-xs flex items-center gap-1 transition-colors"
              >
                <span>←</span>
                <span>सर्वाणि मण्डलानि (All Sabhas)</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Feed Container -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      {!currentSabha ? (
        <section class="rounded-xl border border-amber-900/40 bg-[#0B0D13] p-10 text-center space-y-4">
          <p class="font-mono text-xs uppercase tracking-widest text-amber-500">४०४ · मण्डलम् न लब्धम्</p>
          <h1 class="text-2xl font-bold font-serif text-slate-100">Mandalam Not Found</h1>
          <p class="text-xs text-slate-400">The community Sabha requested does not exist.</p>
          <div class="pt-2">
            <a href="/" class="px-4 py-2 rounded-lg bg-amber-500 text-slate-950 font-bold text-xs uppercase hover:bg-amber-400 inline-block">
              ← Return to Samvāda
            </a>
          </div>
        </section>
      ) : (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          {/* Main Feed Area */}
          <div class="lg:col-span-8">
            <SocialFeed client:load sabhas={sabhas} initialPosts={posts} initialSabha={currentSabha.slug} />
          </div>

          <!-- Sidebar: Sabha Charter & Kasturi EVM Widget -->
          <div class="lg:col-span-4 space-y-6">
            <div class="bg-[#0B0D13] border border-amber-900/40 rounded-xl p-5 space-y-4">
              <h3 class="text-sm font-bold font-serif text-slate-100 flex items-center gap-2">
                <span>{currentSabha.icon}</span>
                <span>मण्डल-नियमः (Sabha Charter)</span>
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                {currentSabha.description_hi || currentSabha.description_en}
              </p>
              <div class="border-t border-slate-800 pt-3 text-[11px] font-mono text-slate-400 space-y-1">
                <div>• स्वातन्त्र्यम् सत्यनिष्ठता च (Dharmic integrity)</div>
                <div>• अद्वेषपूर्णः संवादः (Discourse free of malice)</div>
                <div>• Kasturi EVM immutable verification</div>
              </div>
            </div>

            <!-- Kasturi Chain Status Card -->
            <div class="bg-[#0B0D13] border border-slate-800/80 rounded-xl p-5 space-y-4 shadow-lg shadow-black/40">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-bold">Kasturi Chain EVM</span>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                  Chain ID 108108
                </span>
              </div>
              <div class="text-xs text-slate-400 font-mono space-y-2">
                <div class="flex justify-between border-b border-slate-800 pb-1">
                  <span>Network</span>
                  <span class="text-slate-200">Kasturi Sovereign PoC</span>
                </div>
                <div class="flex justify-between border-b border-slate-800 pb-1">
                  <span>RPC Protocol</span>
                  <span class="text-amber-400 truncate max-w-[170px]">https://sitavani.com/rpc</span>
                </div>
                <div class="flex justify-between">
                  <span>Authority Desk</span>
                  <span class="text-slate-200 truncate max-w-[170px]" title="0xD22913B647d905d931E4dbBc36B2EECABB78329b">0xD229...329b</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </main>

    <Footer language={language} />
  </div>
</Layout>
