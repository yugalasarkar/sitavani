---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDatabasePool } from '../data/database';

const pool = getDatabasePool();

let topPunya: any[] = [];
let topNila: any[] = [];
let topPosts: any[] = [];

try {
  const punyaRes = await pool.query(
    `SELECT u.wallet_address, u.display_name, u.role, u.karma_score, u.total_nila_received,
            u.is_verified_authority, u.avatar_url,
            COUNT(p.id)::int as total_posts
     FROM users u
     LEFT JOIN posts p ON u.wallet_address = p.author_address AND (p.is_deleted IS FALSE OR p.is_deleted IS NULL)
     WHERE (u.is_banned IS FALSE OR u.is_banned IS NULL)
     GROUP BY u.wallet_address
     ORDER BY u.karma_score DESC
     LIMIT 50`
  );
  topPunya = punyaRes.rows;

  const nilaRes = await pool.query(
    `SELECT u.wallet_address, u.display_name, u.role, u.total_nila_received, u.karma_score,
            u.is_verified_authority, u.avatar_url,
            COUNT(nt.id)::int as tips_received_count
     FROM users u
     LEFT JOIN nila_tips nt ON u.wallet_address = nt.recipient_address
     WHERE (u.is_banned IS FALSE OR u.is_banned IS NULL)
       AND u.total_nila_received > 0
     GROUP BY u.wallet_address
     ORDER BY u.total_nila_received DESC
     LIMIT 50`
  );
  topNila = nilaRes.rows;

  const postsRes = await pool.query(
    `SELECT p.id, p.title, p.sabha_slug as sabha, p.score, p.comments_count, p.created_at, p.chain_tx_hash,
            u.wallet_address as author_address, u.display_name as author_name, u.role as author_role
     FROM posts p
     LEFT JOIN users u ON p.author_address = u.wallet_address
     WHERE (p.is_deleted IS FALSE OR p.is_deleted IS NULL)
     ORDER BY p.score DESC, p.created_at DESC
     LIMIT 20`
  );
  topPosts = postsRes.rows;

} catch (e) {
  console.error('Leaderboard query error:', e);
}

const getRankBadge = (index: number) => {
  if (index === 0) return { icon: '🥇', label: 'Rank 1', color: 'text-amber-300 border-amber-500/50 bg-amber-500/10' };
  if (index === 1) return { icon: '🥈', label: 'Rank 2', color: 'text-slate-300 border-slate-400/50 bg-slate-500/10' };
  if (index === 2) return { icon: '🥉', label: 'Rank 3', color: 'text-amber-600 border-amber-700/50 bg-amber-700/10' };
  return { icon: `#${index + 1}`, label: `Rank ${index + 1}`, color: 'text-slate-500 border-slate-800 bg-slate-900/60' };
};
---

<Layout title="श्रेष्ठ-मण्डलम् Śreṣṭha-Maṇḍalam | Sovereign Merit Leaderboard | SITAVANI">
  <Header currentPath="/leaderboard" />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs font-mono">
        <span>👑 श्रेष्ठ-मण्डलम्</span>
        <span>·</span>
        <span>Sovereign Merit & Dakṣiṇā Chamber</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-orange-500">
        श्रेष्ठ-मण्डलम् Śreṣṭha-Maṇḍalam
      </h1>
      <p class="text-xs sm:text-sm text-slate-300 font-sans leading-relaxed">
        The sovereign assembly of scholars, dialectic seekers, and benefactors. Ranked by accumulated intellectual merit (<span class="text-amber-400 font-mono">पुण्य Puṇya</span>) and on-chain community offerings (<span class="text-blue-400 font-mono">नीला Nīlā</span>) on Kasturi Chain.
      </p>

      <!-- Key Economic & Civilizational Metrics Banner -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 max-w-2xl mx-auto">
        <div class="p-3 rounded-xl bg-[#0B0E17] border border-amber-950/60 text-center">
          <span class="block text-[11px] font-mono text-slate-400">Total Scholars</span>
          <span class="text-lg font-bold font-serif text-amber-300">{topPunya.length}</span>
        </div>
        <div class="p-3 rounded-xl bg-[#0B0E17] border border-amber-950/60 text-center">
          <span class="block text-[11px] font-mono text-slate-400">Network Puṇya</span>
          <span class="text-lg font-bold font-serif text-amber-300">
            {topPunya.reduce((acc, u) => acc + (Number(u.karma_score) || 0), 0).toLocaleString()}
          </span>
        </div>
        <div class="p-3 rounded-xl bg-[#0B0E17] border border-amber-950/60 text-center">
          <span class="block text-[11px] font-mono text-slate-400">Dakṣiṇā Earners</span>
          <span class="text-lg font-bold font-serif text-blue-300">{topNila.length}</span>
        </div>
        <div class="p-3 rounded-xl bg-[#0B0E17] border border-amber-950/60 text-center">
          <span class="block text-[11px] font-mono text-slate-400">Seminal Dispatches</span>
          <span class="text-lg font-bold font-serif text-amber-300">{topPosts.length}</span>
        </div>
      </div>
    </div>

    <!-- 2 Column Master Layout: Scholars vs Dakshina -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- Column 1: Top Punya Scholars -->
      <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-amber-950/80 pb-3">
          <h2 class="font-serif text-lg font-bold text-slate-100 flex items-center gap-2">
            <span>📜 पुण्य-श्रेष्ठाः Highest Merit Scholars</span>
          </h2>
          <span class="text-xs font-mono text-amber-400">Ranked by Puṇya</span>
        </div>

        <div class="space-y-2.5">
          {topPunya.map((user, idx) => {
            const badge = getRankBadge(idx);
            const shortAddr = user.wallet_address.slice(0, 6) + '...' + user.wallet_address.slice(-4);
            const isAcharya = user.role === 'ADMIN' || user.role === 'ACHARYA';

            return (
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#0B0E17] border border-slate-800/80 hover:border-amber-900/60 transition-all">
                <div class="flex items-center gap-3">
                  <div class={`w-8 h-8 rounded-lg flex items-center justify-center font-mono font-bold text-xs border ${badge.color}`}>
                    {badge.icon}
                  </div>
                  <div>
                    <a
                      href={`/u/${user.wallet_address}`}
                      class="font-serif font-bold text-slate-200 hover:text-amber-300 transition-colors flex items-center gap-1.5 text-sm"
                    >
                      <span>{user.display_name || shortAddr}</span>
                      {isAcharya && (
                        <span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 text-[10px] font-mono font-bold">
                          आचार्य
                        </span>
                      )}
                    </a>
                    <div class="flex items-center gap-2 text-[11px] font-mono text-slate-500">
                      <span>{user.role}</span>
                      <span>·</span>
                      <span>{user.total_posts} dispatches</span>
                    </div>
                  </div>
                </div>

                <div class="text-right">
                  <span class="font-mono font-bold text-amber-400 text-sm">
                    {Number(user.karma_score).toLocaleString()}
                  </span>
                  <span class="block text-[10px] font-mono text-slate-500">पुण्य Puṇya</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Column 2: Top Nila Dakshina Recipients -->
      <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-amber-950/80 pb-3">
          <h2 class="font-serif text-lg font-bold text-slate-100 flex items-center gap-2">
            <span>🎁 दक्षिणा-पात्राणि Top Nīlā Recipients</span>
          </h2>
          <span class="text-xs font-mono text-blue-400">On-Chain Dakṣiṇā</span>
        </div>

        {topNila.length === 0 ? (
          <div class="p-8 rounded-xl bg-[#0B0E17]/60 border border-slate-800 text-center space-y-2">
            <span class="text-2xl">🪙</span>
            <p class="text-xs text-slate-400 font-mono">No Dakṣiṇā tips recorded yet.</p>
            <p class="text-[11px] text-slate-500">Send Nīlā coins to quality research dispatches to honor scholars!</p>
          </div>
        ) : (
          <div class="space-y-2.5">
            {topNila.map((user, idx) => {
              const badge = getRankBadge(idx);
              const shortAddr = user.wallet_address.slice(0, 6) + '...' + user.wallet_address.slice(-4);

              return (
                <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#0B0E17] border border-slate-800/80 hover:border-blue-900/60 transition-all">
                  <div class="flex items-center gap-3">
                    <div class={`w-8 h-8 rounded-lg flex items-center justify-center font-mono font-bold text-xs border ${badge.color}`}>
                      {badge.icon}
                    </div>
                    <div>
                      <a
                        href={`/u/${user.wallet_address}`}
                        class="font-serif font-bold text-slate-200 hover:text-blue-300 transition-colors flex items-center gap-1.5 text-sm"
                      >
                        <span>{user.display_name || shortAddr}</span>
                      </a>
                      <div class="flex items-center gap-2 text-[11px] font-mono text-slate-500">
                        <span>{user.tips_received_count} tips received</span>
                      </div>
                    </div>
                  </div>

                  <div class="text-right">
                    <span class="font-mono font-bold text-blue-400 text-sm">
                      {Number(user.total_nila_received).toFixed(2)} NILA
                    </span>
                    <span class="block text-[10px] font-mono text-slate-500">नीला Dakṣiṇā</span>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>

    <!-- Section: Seminal High-Accord Dispatches (सर्वश्रेष्ठ-लेखाः) -->
    <div class="space-y-4 pt-4 border-t border-slate-800">
      <div class="flex items-center justify-between border-b border-amber-950/80 pb-3">
        <h2 class="font-serif text-lg font-bold text-slate-100 flex items-center gap-2">
          <span>🏛️ सर्वश्रेष्ठ-लेखाः Seminal High-Accord Dispatches</span>
        </h2>
        <span class="text-xs font-mono text-amber-400">All-Time Highest Accord</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {topPosts.map((post, idx) => (
          <article class="p-4 rounded-xl bg-[#0B0E17] border border-slate-800/80 hover:border-amber-900/60 transition-all flex flex-col justify-between space-y-3">
            <div class="space-y-2">
              <div class="flex items-center justify-between text-[11px] font-mono">
                <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
                  #{idx + 1} · /s/{post.sabha}
                </span>
                <span class="text-slate-500">
                  {new Date(post.created_at).toLocaleDateString()}
                </span>
              </div>

              <a href={`/p/${post.id}`} class="block group">
                <h3 class="font-serif text-sm sm:text-base font-bold text-slate-100 group-hover:text-amber-300 transition-colors line-clamp-2">
                  {post.title}
                </h3>
              </a>
            </div>

            <div class="flex items-center justify-between text-xs font-mono text-slate-400 pt-2 border-t border-slate-900">
              <div class="flex items-center gap-1.5">
                <span class="text-slate-500">By:</span>
                <a href={`/u/${post.author_address}`} class="hover:text-amber-200 text-slate-300">
                  {post.author_name || post.author_address.slice(0, 6) + '...'}
                </a>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-amber-400 font-bold">पुण्य: {post.score}</span>
                <span>प्रतिवचनम्: {post.comments_count}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
