---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SabhaDirectoryView, type SabhaItem } from '../components/SabhaDirectoryView';
import { getDatabasePool } from '../data/database';

const pool = getDatabasePool();

let sabhasList: SabhaItem[] = [];

try {
  const res = await pool.query(
    `SELECT s.slug, s.name_sa, s.name_en, s.name_hi, s.description_en, s.description_hi,
            s.icon, s.color, s.is_official,
            COUNT(p.id)::int as posts_count
     FROM sabhas s
     LEFT JOIN posts p ON s.slug = p.sabha_slug AND (p.is_deleted IS FALSE OR p.is_deleted IS NULL)
     GROUP BY s.slug, s.name_sa, s.name_en, s.name_hi, s.description_en, s.description_hi, s.icon, s.color, s.is_official
     ORDER BY s.is_official DESC, posts_count DESC, s.slug ASC`
  );
  sabhasList = res.rows;
} catch (e) {
  console.error('Error fetching sabhas directory:', e);
}
---

<Layout title="ज्ञान-सभा-सङ्ग्रहः Knowledge Sabhas Directory | SITAVANI">
  <Header currentPath="/sabhas" />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs font-mono">
        <span>🏛️ संसद्-मण्डलम्</span>
        <span>·</span>
        <span>Sovereign Knowledge Assemblies</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-orange-500">
        ज्ञान-सभा-सङ्ग्रहः Assemblies Directory
      </h1>
      <p class="text-xs sm:text-sm text-slate-300 font-sans leading-relaxed">
        Autonomous epistemic chambers of SITAVANI. Each Sabha functions as a sovereign forum dedicated to deep forensic research, sacred textual exegesis, defense technology, and civilizational discourse.
      </p>
    </div>

    <!-- Interactive Sabha Directory Client Island -->
    <SabhaDirectoryView client:load initialSabhas={sabhasList} />
  </main>

  <Footer />
</Layout>
