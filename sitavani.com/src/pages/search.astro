---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDatabasePool } from '../data/database';

const url = new URL(Astro.request.url);
const query = (url.searchParams.get('q') || '').trim();
const activeType = (url.searchParams.get('type') || 'all').toLowerCase();
const limit = 30;

let posts: any[] = [];
let articles: any[] = [];
let sabhas: any[] = [];
let users: any[] = [];
let totalCount = 0;

if (query) {
  const pool = getDatabasePool();
  const pattern = `%${query}%`;

  try {
    if (activeType === 'all' || activeType === 'posts') {
      const postsRes = await pool.query(
        `SELECT p.id, p.title, p.content, p.sabha_slug as sabha, p.author_address, p.score as karma_score,
                p.comments_count, p.created_at, p.chain_tx_hash, p.is_misinformation, p.admin_warning_note,
                u.display_name as author_name, u.role as author_role
         FROM posts p
         LEFT JOIN users u ON p.author_address = u.wallet_address
         WHERE (p.is_deleted IS FALSE OR p.is_deleted IS NULL)
           AND (p.title ILIKE $1 OR p.content ILIKE $1)
         ORDER BY p.score DESC, p.created_at DESC
         LIMIT $2`,
        [pattern, limit]
      );
      posts = postsRes.rows;
    }

    if (activeType === 'all' || activeType === 'articles') {
      const articlesRes = await pool.query(
        `SELECT id, title, title_hi, summary, summary_hi, category, status, published_at, source_name, original_url, image_url
         FROM articles
         WHERE status = 'PUBLISHED'
           AND (title ILIKE $1 OR title_hi ILIKE $1 OR summary ILIKE $1 OR summary_hi ILIKE $1 OR category ILIKE $1)
         ORDER BY published_at DESC
         LIMIT $2`,
        [pattern, limit]
      );
      articles = articlesRes.rows;
    }

    if (activeType === 'all' || activeType === 'sabhas') {
      const sabhasRes = await pool.query(
        `SELECT s.slug, s.name_sa, s.name_en, s.description_en as description, s.icon as icon_name, s.color as accent_color,
                COUNT(p.id)::int as posts_count
         FROM sabhas s
         LEFT JOIN posts p ON s.slug = p.sabha_slug AND (p.is_deleted IS FALSE OR p.is_deleted IS NULL)
         WHERE (s.slug ILIKE $1 OR s.name_sa ILIKE $1 OR s.name_en ILIKE $1 OR s.description_en ILIKE $1)
         GROUP BY s.slug, s.name_sa, s.name_en, s.description_en, s.icon, s.color
         ORDER BY posts_count DESC
         LIMIT $2`,
        [pattern, limit]
      );
      sabhas = sabhasRes.rows;
    }

    if (activeType === 'all' || activeType === 'users') {
      const usersRes = await pool.query(
        `SELECT wallet_address, display_name, bio, role, karma_score, total_nila_received, is_verified_authority
         FROM users
         WHERE (display_name ILIKE $1 OR wallet_address ILIKE $1 OR bio ILIKE $1)
         ORDER BY karma_score DESC
         LIMIT $2`,
        [pattern, limit]
      );
      users = usersRes.rows;
    }

    totalCount = posts.length + articles.length + sabhas.length + users.length;
  } catch (e) {
    console.error('Search query error:', e);
  }
}

const buildTypeUrl = (t: string) => {
  const nextUrl = new URL(url);
  nextUrl.searchParams.set('type', t);
  return nextUrl.toString();
};
---

<Layout title={`अन्वेषणम् Search: ${query || 'Global Discovery'} | SITAVANI`}>
  <Header currentPath="/search" />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="text-center max-w-2xl mx-auto mb-8 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs font-mono">
        <span>🔍 अन्वेषण-मण्डलम्</span>
        <span>·</span>
        <span>Sovereign Knowledge Search</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-orange-400">
        ज्ञान-गवेषणम् Discovery
      </h1>
      <p class="text-xs sm:text-sm text-slate-400 font-sans">
        Search across sovereign news wire, dialectic community dispatches, knowledge sabhas, and scholars.
      </p>
    </div>

    <div class="max-w-3xl mx-auto mb-8">
      <form method="GET" action="/search" class="relative flex items-center shadow-xl">
        <input
          type="text"
          name="q"
          value={query}
          placeholder="Search dispatches, news, sabhas, or seekers (e.g. Mandir, Tejas, ISRO, Sanskrit)..."
          class="w-full px-5 py-4 pl-12 bg-[#0B0E17] border border-amber-900/60 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all font-sans text-sm sm:text-base"
          autofocus
        />
        <span class="absolute left-4 text-slate-400 text-lg">🔍</span>
        <input type="hidden" name="type" value={activeType} />
        <button
          type="submit"
          class="absolute right-2 px-5 py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold text-xs sm:text-sm rounded-lg transition-all shadow-md"
        >
          गवेषणम् Search
        </button>
      </form>

      {!query && (
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-xs">
          <span class="text-slate-500 font-mono">Popular keywords:</span>
          {['Mandir', 'Tejas', 'ISRO', 'Archaeology', 'Sanskrit', 'Kasturi', 'Chola', 'Manuscripts'].map(k => (
            <a
              href={`/search?q=${encodeURIComponent(k)}`}
              class="px-2.5 py-1 rounded-md bg-slate-900/80 border border-slate-800 text-slate-300 hover:border-amber-500/50 hover:text-amber-300 transition-colors"
            >
              #{k}
            </a>
          ))}
        </div>
      )}
    </div>

    {query && (
      <div class="flex items-center justify-center gap-2 border-b border-slate-800 pb-4 mb-8 overflow-x-auto text-xs font-medium">
        {[
          { id: 'all', label_sa: 'सर्वम् All', count: totalCount },
          { id: 'posts', label_sa: 'लेखाः Dispatches', count: posts.length },
          { id: 'articles', label_sa: 'वार्ता News Wire', count: articles.length },
          { id: 'sabhas', label_sa: 'सभाः Sabhas', count: sabhas.length },
          { id: 'users', label_sa: 'साधकाः Seekers', count: users.length },
        ].map(tab => (
          <a
            href={buildTypeUrl(tab.id)}
            class:list={[
              "px-3.5 py-1.5 rounded-lg transition-all flex items-center gap-1.5 whitespace-nowrap",
              activeType === tab.id
                ? "bg-amber-500/20 text-amber-300 border border-amber-500/40 font-semibold"
                : "text-slate-400 hover:text-slate-200 hover:bg-slate-900"
            ]}
          >
            <span>{tab.label_sa}</span>
            <span class="text-[10px] font-mono px-1.5 py-0.2 rounded-full bg-slate-800 text-slate-300">
              {tab.count}
            </span>
          </a>
        ))}
      </div>
    )}

    {query && totalCount === 0 && (
      <div class="text-center py-16 bg-[#0B0E17]/60 border border-slate-800 rounded-xl space-y-3">
        <span class="text-4xl">📜</span>
        <h3 class="text-lg font-serif font-bold text-slate-200">न किमपि प्राप्तम् No results found</h3>
        <p class="text-xs text-slate-400 max-w-md mx-auto">
          No records matched your search term "{query}". Try adjusting your keywords or browse the central sabhas.
        </p>
      </div>
    )}

    {query && totalCount > 0 && (
      <div class="space-y-10">
        {sabhas.length > 0 && (activeType === 'all' || activeType === 'sabhas') && (
          <section class="space-y-4">
            <h2 class="text-sm font-mono tracking-wider uppercase text-amber-400 flex items-center gap-2">
              <span>🏛️ ज्ञान-सभाः Knowledge Sabhas</span>
              <span class="text-slate-600">({sabhas.length})</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {sabhas.map(s => (
                <a
                  href={`/s/${s.slug}`}
                  class="block p-4 rounded-xl bg-[#0B0E17] border border-amber-950/60 hover:border-amber-500/50 hover:bg-slate-900/40 transition-all group"
                >
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-serif font-bold text-amber-200 group-hover:text-amber-300 transition-colors">
                      {s.name_sa}
                    </span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
                      {s.posts_count} dispatches
                    </span>
                  </div>
                  <p class="text-xs text-slate-400 line-clamp-2">{s.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        {posts.length > 0 && (activeType === 'all' || activeType === 'posts') && (
          <section class="space-y-4">
            <h2 class="text-sm font-mono tracking-wider uppercase text-amber-400 flex items-center gap-2">
              <span>🪶 सम्वाद-लेखाः Community Dispatches</span>
              <span class="text-slate-600">({posts.length})</span>
            </h2>
            <div class="space-y-3">
              {posts.map(p => (
                <article class="p-4 sm:p-5 rounded-xl bg-[#0B0E17] border border-slate-800/80 hover:border-amber-900/60 transition-all space-y-2">
                  <div class="flex flex-wrap items-center gap-2 text-xs">
                    <a href={`/s/${p.sabha}`} class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 font-mono text-[11px] hover:underline">
                      /s/{p.sabha}
                    </a>
                    <span class="text-slate-600">·</span>
                    <a href={`/u/${p.author_address}`} class="font-mono text-slate-300 hover:text-amber-200">
                      {p.author_name || p.author_address.slice(0, 6) + '...' + p.author_address.slice(-4)}
                    </a>
                    {p.author_role === 'ADMIN' && (
                      <span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 text-[10px] font-mono font-bold">
                        आचार्य Ācārya
                      </span>
                    )}
                    <span class="text-slate-600">·</span>
                    <span class="text-slate-500 text-[11px]">
                      {new Date(p.created_at).toLocaleDateString()}
                    </span>
                  </div>

                  <a href={`/p/${p.id}`} class="block group">
                    <h3 class="font-serif text-base sm:text-lg font-bold text-slate-100 group-hover:text-amber-300 transition-colors">
                      {p.title}
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-400 line-clamp-2 mt-1 font-sans">
                      {p.content}
                    </p>
                  </a>

                  <div class="flex items-center gap-4 text-xs font-mono text-slate-400 pt-2 border-t border-slate-900">
                    <span class="text-amber-400">पुण्य: {p.karma_score}</span>
                    <span>प्रतिवचनम्: {p.comments_count} replies</span>
                    {p.chain_tx_hash && (
                      <span class="text-emerald-400 flex items-center gap-1">
                        <span>⬡</span>
                        <span>On-Chain Verified</span>
                      </span>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {articles.length > 0 && (activeType === 'all' || activeType === 'articles') && (
          <section class="space-y-4">
            <h2 class="text-sm font-mono tracking-wider uppercase text-amber-400 flex items-center gap-2">
              <span>📰 वार्ता News Wire</span>
              <span class="text-slate-600">({articles.length})</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {articles.map(a => (
                <article class="p-4 rounded-xl bg-[#0B0E17] border border-slate-800/80 hover:border-amber-900/60 transition-all flex flex-col justify-between space-y-3">
                  <div class="space-y-2">
                    <div class="flex items-center justify-between text-[11px] font-mono">
                      <span class="px-2 py-0.5 rounded bg-slate-800 text-amber-400">
                        {a.category}
                      </span>
                      <span class="text-slate-500">
                        {new Date(a.published_at).toLocaleDateString()}
                      </span>
                    </div>
                    <a href={`/articles/${a.id}`} class="block group">
                      <h3 class="font-serif text-sm sm:text-base font-bold text-slate-200 group-hover:text-amber-300 transition-colors line-clamp-2">
                        {a.title}
                      </h3>
                      <p class="text-xs text-slate-400 line-clamp-2 mt-1">
                        {a.summary || a.title_hi}
                      </p>
                    </a>
                  </div>
                  <div class="text-[11px] text-slate-500 font-mono flex items-center justify-between pt-2 border-t border-slate-900">
                    <span>Source: {a.source_name}</span>
                    <a href={a.original_url} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                      Original ↗
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {users.length > 0 && (activeType === 'all' || activeType === 'users') && (
          <section class="space-y-4">
            <h2 class="text-sm font-mono tracking-wider uppercase text-amber-400 flex items-center gap-2">
              <span>👥 साधकाः Seekers & Scholars</span>
              <span class="text-slate-600">({users.length})</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {users.map(u => (
                <a
                  href={`/u/${u.wallet_address}`}
                  class="flex items-center gap-3 p-4 rounded-xl bg-[#0B0E17] border border-slate-800/80 hover:border-amber-500/40 transition-all group"
                >
                  <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-600 to-orange-600 flex items-center justify-center text-slate-950 font-bold font-serif text-sm">
                    {u.display_name ? u.display_name.slice(0, 2).toUpperCase() : '👤'}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5">
                      <span class="font-serif font-bold text-slate-200 group-hover:text-amber-300 truncate text-sm">
                        {u.display_name || u.wallet_address.slice(0, 6) + '...' + u.wallet_address.slice(-4)}
                      </span>
                      {u.is_verified_authority && (
                        <span class="text-amber-400 text-xs" title="Verified Authority">✓</span>
                      )}
                    </div>
                    <div class="flex items-center gap-2 text-[11px] font-mono text-slate-400">
                      <span class="text-amber-400">पुण्य: {u.karma_score}</span>
                      <span>·</span>
                      <span class="text-slate-500">{u.role}</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </main>

  <Footer />
</Layout>
