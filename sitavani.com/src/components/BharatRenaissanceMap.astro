---
import type { DisplayLanguage } from '../types';

interface Props { language?: DisplayLanguage }
const { language = 'dual' } = Astro.props;
---

<section id="heritage" aria-labelledby="renaissance-map-title" class="h-full rounded-xl border border-amber-900/30 bg-[#0A0D14] p-6 shadow-xl relative overflow-hidden">
  <div class="absolute -top-20 -left-16 w-72 h-72 rounded-full border border-amber-500/10"></div>
  <div class="absolute -top-12 -left-8 w-56 h-56 rounded-full border border-amber-500/10"></div>
  <div class="relative flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-amber-950/40 pb-4 mb-5">
    <div>
      <p class="text-xs font-mono text-amber-400 uppercase tracking-widest font-semibold">Bharat Renaissance Map</p>
      <h2 id="renaissance-map-title" class="text-xl sm:text-2xl font-serif font-bold text-slate-100 mt-1">{language === 'hi' ? 'स्रोत-आधारित राज्य विकास' : 'State-level sourced developments'}</h2>
    </div>
    <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 border border-slate-800 rounded px-2 py-1">Sourced records only</span>
  </div>
  <div class="relative min-h-48 rounded-xl border border-dashed border-slate-700/80 bg-[#0E121D]/70 flex items-center justify-center p-6 text-center">
    <div class="max-w-lg">
      <span class="text-3xl text-amber-500/60" aria-hidden="true">◇</span>
      <p class="mt-3 text-sm text-slate-300">No state-level records with source links are configured yet. The map will populate as editors publish sourced heritage, infrastructure, energy, and manufacturing reports.</p>
    </div>
  </div>
</section>
