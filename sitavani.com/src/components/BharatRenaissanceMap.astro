---
import { getDatabasePool } from '../data/database';
import type { DisplayLanguage } from '../types';

interface Props { language?: DisplayLanguage }
const { language = 'dual' } = Astro.props;

interface RegionNode {
  id: string;
  state: string;
  zone: string;
  title: string;
  title_hi: string;
  domain: string;
  icon: string;
  articleId?: string;
  summary: string;
}

const REGION_NODES: RegionNode[] = [
  {
    id: 'gujarat',
    state: 'Gujarat (Saurashtra)',
    zone: 'Western Marches',
    title: 'Junagadh Sudarshana Dam Epigraphy',
    title_hi: 'जूनागढ़ सुदर्शन झील शिलालेख एवं जल प्रबंधन',
    domain: 'Heritage & Engineering',
    icon: '🏛️',
    articleId: 'art-001',
    summary: 'ASI excavations confirm 800 years of unbroken civic hydraulic engineering across Maurya, Western Kshatrapa, and Gupta eras.'
  },
  {
    id: 'tamilnadu',
    state: 'Tamil Nadu (Thanjavur & Keezhadi)',
    zone: 'Southern Seaboard',
    title: 'Chola Bronze Repatriation & Keezhadi Vaigai Civilization',
    title_hi: 'तंजावुर चोल कांस्य प्रतिमा वापसी एवं कीझाड़ी सभ्यता',
    domain: 'Archaeology & Metallurgy',
    icon: '🛕',
    articleId: 'art-001',
    summary: 'Sacred 10th-century Chola Nataraja restored to sanctum; 6th-century BCE Keezhadi excavations substantiate deep Sangam urban literacy.'
  },
  {
    id: 'uttarpradesh',
    state: 'Uttar Pradesh (Kashi & Ayodhya)',
    zone: 'Gangetic Hearth',
    title: 'Kashi Vishwanath Corridor & Panchkroshi Restoration',
    title_hi: 'काशी विश्वनाथ गलियारा एवं पंचक्रोशी परिक्रमा पुनरुद्धार',
    domain: 'Spiritual Infrastructure',
    icon: '🕉️',
    articleId: 'art-002',
    summary: 'Reclamation of 108 historic water kunds and benchmark dharmic pilgrimage infrastructure surpassing 150 million pilgrims.'
  },
  {
    id: 'karnataka',
    state: 'Karnataka (Hampi / Tungabhadra)',
    zone: 'Deccan Plateau',
    title: 'Submerged 7th-Century Shrine Complex',
    title_hi: 'तुंगभद्रा बेसिन में 7वीं सदी का जलमग्न शिव मंदिर परिसर',
    domain: 'GPR Epigraphy',
    icon: '🔱',
    articleId: 'art-pend-001',
    summary: 'Ground Penetrating Radar reveals buried pre-Vijayanagara monumental stone sanctum in the Tungabhadra river basin.'
  },
  {
    id: 'odisha',
    state: 'Odisha (Chandipur & Wheeler Island)',
    zone: 'Eastern Littoral',
    title: 'DRDO Hypersonic & Strategic Deterrence Trials',
    title_hi: 'डीआरडीओ हाइपरसोनिक प्रौद्योगिकी परीक्षण एवं सामरिक सुरक्षा',
    domain: 'Defense & Aerospace',
    icon: '🛡️',
    articleId: 'art-pend-002',
    summary: 'Indigenous scramjet propulsion and advanced radar validation strengthening sovereign aerospace defense.'
  },
  {
    id: 'andhrapradesh',
    state: 'Andhra Pradesh (Sriharikota)',
    zone: 'Spaceport Coast',
    title: 'ISRO Cryogenic Restart for Chandrayaan-4 & Gaganyaan',
    title_hi: 'इसरो क्रायोजेनिक पुनरारंभ एवं गगनयान मानव-रेटिंग योग्यता',
    domain: 'Deep Space Operations',
    icon: '🚀',
    articleId: 'art-004',
    summary: 'CE-20 cryogenic upper stage qualification enabling multi-burn lunar trajectories and crewed orbital flight.'
  }
];

// Let's also check if we have any recently published articles in DB to enrich nodes
let publishedArticles: any[] = [];
try {
  const pool = getDatabasePool();
  const res = await pool.query(
    `SELECT id, title, title_hi, category, original_url FROM articles WHERE status = 'PUBLISHED' ORDER BY published_at DESC LIMIT 20`
  );
  publishedArticles = res.rows;
} catch (e) {
  console.error('Error fetching articles for map:', e);
}
---

<section id="heritage" aria-labelledby="renaissance-map-title" class="h-full rounded-2xl border border-amber-900/40 bg-gradient-to-br from-[#0A0D14] via-[#0E121E] to-[#080A10] p-6 sm:p-8 shadow-2xl relative overflow-hidden flex flex-col justify-between">
  <!-- Subtle decorative ambient background rings -->
  <div class="absolute -top-24 -left-20 w-80 h-80 rounded-full border border-amber-500/10 pointer-events-none"></div>
  <div class="absolute -top-12 -left-10 w-60 h-60 rounded-full border border-amber-500/10 pointer-events-none"></div>

  <div>
    <!-- Section Header -->
    <div class="relative flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-amber-950/60 pb-5 mb-6">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <p class="text-[11px] font-mono text-amber-400 uppercase tracking-widest font-bold">
            Bharat Renaissance Territorial Matrix
          </p>
        </div>
        <h2 id="renaissance-map-title" class="text-xl sm:text-2xl font-serif font-bold text-slate-100">
          {language === 'hi' ? 'भारत पुनर्जागरण मानचित्र · स्रोत-आधारित विकास' : 'भारत पुनर्जागरण मानचित्र · Sovereign Territorial Grid'}
        </h2>
        <p class="text-xs text-slate-400 max-w-xl">
          Geo-referenced records linking civilizational archaeology, deep space missions, defense infrastructure, and sacred corridors across Bharat.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-[11px] font-mono uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 rounded-lg px-2.5 py-1">
          ● 6 Sovereign Nodes Active
        </span>
      </div>
    </div>

    <!-- Territorial Grid Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {REGION_NODES.map((node) => (
        <div class="rounded-xl border border-slate-800 bg-[#07090E]/80 p-4 hover:border-amber-500/50 hover:bg-[#0B0F19] transition-all duration-200 group flex flex-col justify-between space-y-3 shadow-lg">
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[10px] font-mono">
              <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 font-semibold">
                {node.zone}
              </span>
              <span class="text-slate-500">{node.domain}</span>
            </div>

            <div>
              <div class="flex items-center gap-1.5 text-xs font-mono font-bold text-slate-300">
                <span>{node.icon}</span>
                <span>{node.state}</span>
              </div>
              <h3 class="font-serif font-bold text-sm text-slate-100 group-hover:text-amber-300 transition-colors leading-snug mt-1">
                {node.title}
              </h3>
              {node.title_hi && (
                <p class="font-hindi-serif text-[11px] text-amber-200/80 mt-0.5 line-clamp-1">
                  {node.title_hi}
                </p>
              )}
            </div>

            <p class="text-xs text-slate-400 leading-relaxed line-clamp-2">
              {node.summary}
            </p>
          </div>

          <div class="pt-2 border-t border-slate-900 flex items-center justify-between text-xs font-mono">
            {node.articleId ? (
              <a
                href={`/articles/${encodeURIComponent(node.articleId)}`}
                class="text-amber-400 hover:text-amber-300 flex items-center gap-1 font-semibold group-hover:translate-x-0.5 transition-transform"
              >
                <span>Read Dispatch</span>
                <span>→</span>
              </a>
            ) : (
              <span class="text-slate-500">Archival Record</span>
            )}
            <span class="text-[10px] text-slate-600">Sourced</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Matrix Legend -->
  <div class="pt-5 mt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-slate-400">
    <div class="flex items-center gap-4">
      <span>• West: Hydraulic Engineering</span>
      <span>• South: Epigraphy & Spaceport</span>
      <span>• East: Deterrence Flight Range</span>
      <span>• North: Sacred Corridors</span>
    </div>
    <a href="/news" class="text-amber-400 hover:underline">
      View All Regional Dispatches on Wire →
    </a>
  </div>
</section>
