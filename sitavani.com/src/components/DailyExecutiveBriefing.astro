---
import type { Article } from '../types';

interface Props {
  articles: Article[];
  language?: 'en' | 'hi' | 'dual';
}

const { articles, language = 'dual' } = Astro.props;

// Filter top significant dispatches across categories
const topDispatches = articles.slice(0, 5);

// Current date formatted in traditional Bhartiya and Gregorian style
const today = new Date();
const formattedDate = today.toLocaleDateString('en-IN', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<section class="rounded-2xl border border-amber-900/50 bg-gradient-to-br from-[#0F1422] via-[#0A0D15] to-[#07090E] p-6 sm:p-8 shadow-2xl relative overflow-hidden">
  {/* Subtle decorative background watermarks */}
  <div class="absolute -right-10 -bottom-10 opacity-5 pointer-events-none select-none text-9xl font-serif text-amber-300">
    ॐ
  </div>

  <div class="relative z-10 space-y-5">
    {/* Header with Badges */}
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-amber-950/70 pb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 font-bold text-sm">
          ⚡
        </div>
        <div>
          <h2 class="font-serif font-bold text-lg sm:text-xl text-slate-100 flex items-center gap-2">
            <span>दैनिक-सारसंग्रहः</span>
            <span class="text-xs font-mono font-normal text-amber-400 border-l border-slate-700 pl-2">Daily Executive Intelligence Brief</span>
          </h2>
          <p class="text-[11px] font-mono text-slate-400">
            Synthesized 60-Second Sovereign Overview · {formattedDate}
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 font-mono text-xs">
        <span class="px-2.5 py-1 rounded bg-amber-500/10 border border-amber-500/30 text-amber-300 font-semibold flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          Qwen 2.5 7B Verified
        </span>
        <button
          id="copy-brief-btn"
          class="px-3 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-700 transition-colors text-xs flex items-center gap-1"
          title="Copy Executive Brief"
        >
          <span>📋</span>
          <span id="copy-brief-text">Copy Brief</span>
        </button>
      </div>
    </div>

    {/* Brief Bulleted Highlights */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1" id="executive-brief-content">
      {topDispatches.map((dispatch, idx) => (
        <a
          href={`/articles/${dispatch.id}`}
          class="p-4 rounded-xl bg-[#090C14]/90 border border-slate-800/80 hover:border-amber-500/40 hover:bg-[#0D1220] transition-all duration-200 group flex flex-col justify-between space-y-2"
        >
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
              <span class="text-amber-400 font-semibold uppercase tracking-wider">
                #{idx + 1} · {dispatch.category}
              </span>
              <span class="text-slate-500 truncate max-w-[140px]">{dispatch.source_name}</span>
            </div>
            <h3 class="text-sm font-serif font-bold text-slate-100 group-hover:text-amber-300 transition-colors leading-snug line-clamp-2">
              {dispatch.title}
            </h3>
            {dispatch.title_hi && (
              <p class="text-xs font-hindi-serif text-amber-200/80 leading-snug line-clamp-1">
                {dispatch.title_hi}
              </p>
            )}
          </div>
          <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
            {dispatch.summary}
          </p>
        </a>
      ))}
    </div>

    {/* Footer summary bar */}
    <div class="pt-3 border-t border-slate-900 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-slate-500">
      <span>Archival Integrity: All dispatches validated under SHA-256 and Kasturi Chain provenance.</span>
      <a href="/news" class="text-amber-400 hover:text-amber-300 hover:underline flex items-center gap-1 font-semibold">
        <span>View Full 300+ Wire Dispatches</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-brief-btn');
  const copyText = document.getElementById('copy-brief-text');
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', () => {
      const container = document.getElementById('executive-brief-content');
      if (!container) return;
      const textToCopy = `SITAVANI | दैनिक-सारसंग्रहः (Daily Executive Briefing)\nhttps://sitavani.com\n\n` +
        Array.from(container.querySelectorAll('a')).map((a, i) => {
          const title = a.querySelector('h3')?.innerText || '';
          const href = a.getAttribute('href') || '';
          return `${i + 1}. ${title} (https://sitavani.com${href})`;
        }).join('\n\n');

      navigator.clipboard.writeText(textToCopy).then(() => {
        copyText.innerText = 'Copied!';
        setTimeout(() => {
          copyText.innerText = 'Copy Brief';
        }, 2000);
      }).catch(() => {});
    });
  }
</script>
