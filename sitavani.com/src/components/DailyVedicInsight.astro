---
import type { DisplayLanguage } from '../types';

interface Props { language?: DisplayLanguage }
const { language = 'dual' } = Astro.props;
---

<section aria-labelledby="vedic-insight-title" class="min-h-64 rounded-xl border border-amber-900/40 bg-gradient-to-br from-[#0C0F17] via-[#0D121F] to-[#0A0C14] p-6 shadow-xl relative overflow-hidden">
  <div class="absolute top-0 right-0 w-64 h-64 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="flex items-center gap-3 border-b border-amber-950/40 pb-4">
    <span class="text-amber-400 font-serif text-xl" aria-hidden="true">ॐ</span>
    <div>
      <p class="font-mono text-[10px] uppercase tracking-widest text-amber-400 font-bold">Vedic to Space Codex</p>
      <h2 id="vedic-insight-title" class="text-lg font-serif font-semibold text-slate-100">{language === 'hi' ? 'पाठ और संदर्भ' : 'Text, context, and sources'}</h2>
    </div>
  </div>
  <div class="relative mt-5 rounded-lg border border-dashed border-slate-700/80 bg-black/20 p-4">
    <p class="text-sm text-slate-300">No source-reviewed entry is available yet. Textual references and modern connections will be shown separately, with citations, when reviewed by an editor.</p>
    <p class="mt-3 text-xs text-slate-500">A cultural interpretation will not be presented as a scientific or historical proof.</p>
  </div>
</section>
