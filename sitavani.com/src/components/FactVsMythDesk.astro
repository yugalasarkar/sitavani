---
import type { DisplayLanguage } from '../types';

interface Props { language?: DisplayLanguage }
const { language = 'dual' } = Astro.props;
---

<section id="facts" aria-labelledby="fact-shield-title" class="h-full rounded-xl border border-amber-900/30 bg-[#090C12] p-6 shadow-xl">
  <div class="flex items-center gap-3 border-b border-amber-950/40 pb-4">
    <span class="text-amber-400 text-xl" aria-hidden="true">◈</span>
    <div>
      <p class="text-xs font-mono text-amber-400 uppercase font-semibold">Decolonial Fact-Shield</p>
      <h2 id="fact-shield-title" class="text-xl font-serif font-bold text-slate-100">{language === 'hi' ? 'सत्यापन डेस्क' : 'Fact-check desk'}</h2>
    </div>
  </div>
  <div class="mt-5 rounded-lg border border-dashed border-slate-700 bg-[#0C1019] p-4">
    <p class="text-sm text-slate-300">No reviewed claims are available yet. This desk will show the claim, evidence, source links, and review date together.</p>
    <p class="mt-3 text-xs text-slate-500">A claim will not be labelled false or verified without adequate evidence.</p>
  </div>
</section>
