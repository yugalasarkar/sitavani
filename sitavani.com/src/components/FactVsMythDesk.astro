---
import { getDatabasePool } from '../data/database';
import type { DisplayLanguage } from '../types';

interface Props { language?: DisplayLanguage }
const { language = 'dual' } = Astro.props;

let factArticle: any = null;
try {
  const pool = getDatabasePool();
  const res = await pool.query(
    `SELECT id, title, title_hi, summary, summary_hi, original_url, source_name, published_at, url_hash
     FROM articles
     WHERE status = 'PUBLISHED' AND category = 'NARRATIVE_FACTS'
     ORDER BY published_at DESC LIMIT 1`
  );
  factArticle = res.rows[0] || null;
} catch (e) {
  console.error('Fact desk query error:', e);
}
---

<section id="facts" aria-labelledby="fact-shield-title" class="h-full rounded-2xl border border-amber-900/40 bg-gradient-to-br from-[#090C12] via-[#0C1019] to-[#080A0F] p-6 sm:p-7 shadow-xl flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between border-b border-amber-950/60 pb-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-bold font-mono text-base">
          ◈
        </div>
        <div>
          <p class="text-[11px] font-mono text-amber-400 uppercase font-bold tracking-wider">
            Decolonial Fact-Shield
          </p>
          <h2 id="fact-shield-title" class="text-lg font-serif font-bold text-slate-100">
            {language === 'hi' ? 'सत्यापन-कवचम् Fact-Check Desk' : 'सत्यापन-कवचम् · Empirical Audit Desk'}
          </h2>
        </div>
      </div>
      <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Verified Evidence</span>
      </span>
    </div>

    {factArticle ? (
      <div class="mt-5 space-y-4">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-slate-500 block mb-1">
            Subject Matter Audit:
          </span>
          <a href={`/articles/${encodeURIComponent(factArticle.id)}`} class="block group">
            <h3 class="text-base sm:text-lg font-serif font-bold text-slate-100 group-hover:text-amber-300 transition-colors leading-snug">
              {factArticle.title}
            </h3>
          </a>
          {factArticle.title_hi && (
            <p class="font-hindi-serif text-xs sm:text-sm text-amber-200/90 mt-1.5 line-clamp-2">
              {factArticle.title_hi}
            </p>
          )}
        </div>

        <div class="p-4 rounded-xl border border-slate-800 bg-[#07090E]/80 text-xs sm:text-sm text-slate-300 font-sans leading-relaxed space-y-2">
          <div class="flex items-center gap-1.5 text-[11px] font-mono text-amber-400 font-semibold uppercase">
            <span>⚖️ Forensic Refutation & Facts:</span>
          </div>
          <p class="line-clamp-4 text-slate-300">
            {factArticle.summary}
          </p>
        </div>

        <div class="text-[11px] font-mono text-slate-400 space-y-1 pt-1">
          <div class="flex items-center justify-between">
            <span>Primary Source:</span>
            <span class="text-slate-200">{factArticle.source_name}</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Satya Mudrā Hash:</span>
            <code class="text-emerald-400 bg-black/40 px-1.5 py-0.5 rounded text-[10px] border border-emerald-950">
              {factArticle.url_hash.slice(0, 16)}...
            </code>
          </div>
        </div>
      </div>
    ) : (
      <div class="mt-5 space-y-4">
        <div class="p-4 rounded-xl border border-dashed border-slate-800 bg-[#0C1019] text-xs text-slate-400 space-y-2">
          <div class="text-amber-400 font-mono text-xs font-bold">● Rigorous Epistemic Charter</div>
          <p>
            No assertion is published without primary archaeological, epigraphic, computational, or institutional documentation. Claims contrary to verified records are forensically rebutted.
          </p>
        </div>
      </div>
    )}
  </div>

  <div class="pt-5 mt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
    {factArticle ? (
      <>
        <a
          href={`/articles/${encodeURIComponent(factArticle.id)}`}
          class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1 group"
        >
          <span>Read Full Sourced Investigation</span>
          <span class="group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
        <a
          href={factArticle.original_url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-500 hover:text-slate-300"
        >
          Source Record ↗
        </a>
      </>
    ) : (
      <span class="text-slate-500">Editorial verification active</span>
    )}
  </div>
</section>
