---
import type { DisplayLanguage, NewsCategory } from '../types';

interface Props {
  language?: DisplayLanguage;
  selectedCategory?: NewsCategory | 'ALL';
  searchQuery?: string;
}

const { language = 'dual', selectedCategory = 'ALL', searchQuery = '' } = Astro.props;
const categories: Array<{ id: NewsCategory | 'ALL'; label: string }> = [
  { id: 'ALL', label: 'All dispatches' },
  { id: 'HERITAGE', label: 'Heritage' },
  { id: 'MANDIR', label: 'Mandir' },
  { id: 'DEFENSE', label: 'Defense' },
  { id: 'SCIENCE', label: 'Science' },
  { id: 'GOVERNANCE', label: 'Governance' },
  { id: 'NARRATIVE_FACTS', label: 'Fact Shield' }
];
const hrefFor = (values: Record<string, string>) => {
  const params = new URLSearchParams();
  if (selectedCategory !== 'ALL') params.set('category', selectedCategory);
  if (searchQuery) params.set('search', searchQuery);
  if (language !== 'dual') params.set('lang', language);
  for (const [key, value] of Object.entries(values)) {
    if (value) params.set(key, value);
    else params.delete(key);
  }
  const query = params.toString();
  return query ? `/?${query}` : '/';
};
---

<header class="sticky top-0 z-40 bg-[#07080B]/95 backdrop-blur-md border-b border-amber-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-16 flex flex-wrap items-center justify-between gap-3 py-2">
    <a href="/" class="flex items-center gap-2 text-left group focus-visible:outline-none">
      <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-amber-500 to-orange-500 animate-pulse"></span>
      <span class="font-brand text-lg sm:text-xl font-bold tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-orange-500">
        SITAVANI <span class="text-amber-500/80 font-normal">|</span> सीतावाणी
      </span>
    </a>

    <nav aria-label="News categories" class="hidden xl:flex items-center gap-4 text-xs uppercase tracking-wider font-medium text-slate-400">
      {categories.map(({ id, label }) => (
        <a
          href={id === 'ALL' ? hrefFor({ category: '' }) : hrefFor({ category: id })}
          aria-current={selectedCategory === id ? 'page' : undefined}
          class:list={["transition-colors hover:text-amber-400", selectedCategory === id && 'text-amber-400 font-semibold']}
        >{label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <form action="/" method="get" role="search" class="hidden sm:flex items-center">
        {selectedCategory !== 'ALL' && <input type="hidden" name="category" value={selectedCategory} />}
        {language !== 'dual' && <input type="hidden" name="lang" value={language} />}
        <label class="sr-only" for="site-search">Search published dispatches</label>
        <input id="site-search" name="search" value={searchQuery} placeholder="Search dispatches" class="w-36 lg:w-48 bg-[#0D1017] border border-slate-800 rounded-l-md px-2.5 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-amber-500/50" />
        <button class="px-2.5 py-1.5 text-xs rounded-r-md border border-l-0 border-slate-800 bg-[#121722] text-amber-300 hover:bg-amber-500/10" type="submit">Search</button>
      </form>

      <nav aria-label="Display language" class="flex items-center p-0.5 bg-[#0D1017] border border-slate-800 rounded-md text-[11px] font-medium">
        {(['en', 'hi', 'dual'] as const).map((option) => (
          <a href={hrefFor({ lang: option })} aria-current={language === option ? 'true' : undefined} class:list={["px-2 py-1 rounded transition-colors", language === option ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40' : 'text-slate-400 hover:text-slate-200']}>
            {option === 'hi' ? 'हिन्दी' : option === 'en' ? 'EN' : 'Dual'}
          </a>
        ))}
      </nav>

      <a href="/admin" class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium rounded-md border bg-[#0D1017] text-slate-300 border-amber-900/40 hover:border-amber-600/50 hover:text-amber-300 transition-all">
        <span>Editorial Desk</span>
      </a>
    </div>
  </div>
</header>
