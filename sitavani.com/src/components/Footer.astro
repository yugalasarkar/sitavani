---
import type { DisplayLanguage } from '../types';

interface Props { language?: DisplayLanguage }
const { language = 'dual' } = Astro.props;
---

<footer class="bg-[#050609] border-t border-amber-950/40 text-slate-400 py-10 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-amber-950/40">
      <div class="md:col-span-2 space-y-3">
        <a href="/" class="font-brand font-bold text-slate-200 tracking-wider text-base">SITAVANI <span class="text-amber-500 font-normal">|</span> सीतावाणी</a>
        <p class="text-xs text-slate-400 leading-relaxed max-w-lg">{language === 'hi' ? 'स्रोत-संदर्भित समाचार और संपादकीय लेखन।' : 'Source-attributed reporting and editorial coverage across heritage, science, technology, infrastructure, defense, governance, and Bhartiya knowledge traditions.'}</p>
        <p class="text-[11px] font-mono text-slate-500">Decentralized civilizational discourse anchored on PostgreSQL & Kasturi Chain EVM (Chain ID 108108). Autonomous ingestion daemon active.</p>
      </div>
      <div>
        <h2 class="text-xs font-mono uppercase tracking-wider text-amber-500 font-semibold mb-3">Explore & Discover</h2>
        <ul class="space-y-2 text-xs font-mono">
          <li><a href="/news" class="hover:text-amber-400">वार्ता News Wire</a></li>
          <li><a href="/sabhas" class="hover:text-amber-400">सभाः Knowledge Sabhas</a></li>
          <li><a href="/leaderboard" class="hover:text-amber-400">श्रेष्ठ-मण्डलम् Leaderboard</a></li>
          <li><a href="/search" class="hover:text-amber-400">अन्वेषणम् Global Search</a></li>
          <li><a href="/admin" class="hover:text-amber-400">सम्पादक Editorial Desk</a></li>
          <li><a href="https://satya.yugala.org" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 text-amber-300">Satya Explorer ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-slate-500">
      <span>© 2026 SITAVANI · Kasturi EVM (108108) · Nīlā (नीला) Currency · Akhanda Bharat</span>
      <a href="https://satya.yugala.org" target="_blank" rel="noopener noreferrer" class="hover:underline text-amber-400/80">satya.yugala.org</a>
    </div>
  </div>
</footer>
