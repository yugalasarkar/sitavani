---
import type { DisplayLanguage, FeedStats } from '../types';

interface Props {
  language?: DisplayLanguage;
  stats: FeedStats;
}

const { language = 'dual', stats } = Astro.props;
---

<section aria-labelledby="pulse-title" class="bg-[#090C12] border-y border-amber-950/40 py-4 px-4 rounded-lg">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 rounded-full bg-amber-400"></span>
      <div>
        <h2 id="pulse-title" class="font-brand font-bold text-amber-400 uppercase tracking-widest text-xs">{language === 'hi' ? 'भारत शक्ति पल्स' : 'Bharat Shakti Pulse'}</h2>
        <p class="text-[10px] text-slate-500 font-mono">Sourced milestones</p>
      </div>
    </div>
    <p class="text-xs text-slate-400 max-w-2xl">No source-reviewed milestone is configured yet. Source-attributed reporting will appear here after editorial review and publication.</p>
    <div class="text-xs font-mono text-slate-400 border-l border-amber-900/40 pl-4">
      <span class="block text-[10px] uppercase tracking-wider">Published articles</span>
      <strong class="text-amber-300 tabular-nums">{stats.total_published}</strong>
    </div>
  </div>
</section>
