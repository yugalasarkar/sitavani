# PostgreSQL connection. Use a role dedicated to Sitavani; URL-encode special
# characters in the username or password. Production defaults to verified TLS.
DATABASE_URL=postgresql://sitavani:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/sitavani
DATABASE_SSL=require
DATABASE_POOL_MAX=10

# Generate two separate random values of at least 32 characters before enabling admin access.
ADMIN_ACCESS_KEY=
ADMIN_SESSION_SECRET=
